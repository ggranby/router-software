-- @@GENERATED_NOTE@@
-- Template: Programs/tools/templates/HornetLinkNative.lua.in
--[[
  HornetLinkNative.lua - Hornet Link native F/A-18C exporter
  ============================================================
  Talks to hornet-link.exe directly. DCS-BIOS is NOT required; if it is
  installed this script chains its hooks and both keep working.

  INSTALL (pick one)
  ------------------------------------------------------------
  a) Copy this file to  Saved Games\DCS\Scripts\HornetLinkNative.lua
     and add these lines at the END of Saved Games\DCS\Scripts\Export.lua:

        local hlnOk, hlnErr = pcall(dofile, lfs.writedir() .. "Scripts/HornetLinkNative.lua")
        if not hlnOk then log.write("HornetLinkNative", log.ERROR, tostring(hlnErr)) end

  b) Or paste this whole file at the end of Export.lua.

  WHAT IT DOES
  ------------------------------------------------------------
  - Runs only in the aircraft named below. In any other aircraft it stays
    quiet and tells the bridge "active 0" once per second.
  - Reads the cockpit (argument values and display text) for catalogue
    controls only, and sends values that changed, keyed by catalogue id.
    Every second it sends everything again (full refresh).
  - Receives typed input events from the bridge and applies them with
    DCS's own performClickableAction.

  WIRE FORMAT (UDP, plain text so you can read it in a packet capture)
  ------------------------------------------------------------
  exporter -> bridge, 127.0.0.1:HLN_BRIDGE_PORT, one or more datagrams per tick:
      HLN 2 <catalog hash> <aircraft> <active 0|1> <full 0|1>
      <id>=<value>          e.g.  0101=1      (position, lamp, analog 0-65535)
      <id>=T:<text>         e.g.  0240=T:  1234   (% escapes %, =, control bytes)
  bridge -> exporter, this script listens on 127.0.0.1:HLN_LISTEN_PORT:
      <id> SET <n>  |  <id> STEP <+/-n>  |  <id> PRESS  |  <id> RELEASE  |  <id> ANALOG <0-65535>
      e.g. "0101 SET 1" puts the Master Arm switch to ARM.

  DCS DATA
  ------------------------------------------------------------
  Rows marked "DCS data: dcsbios (TEMPORARY)" use device/command/argument
  numbers taken from DCS-BIOS until native data is extracted. See
  docs/DCS_DATA_PROVENANCE.md.
]]

-- -- Settings you may change ------------------------------------------------
local HLN_HOST          = "127.0.0.1"
local HLN_BRIDGE_PORT   = 42003   -- hornet-link.exe listens here
local HLN_LISTEN_PORT   = 42004   -- this script listens here for inputs
local HLN_SAMPLE_HZ     = 30      -- cockpit reads per second
local HLN_FULL_REFRESH  = 1.0     -- seconds between full refreshes
local HLN_MAX_DATAGRAM  = 1200    -- bytes
local HLN_RELEASE_TICKS = 3       -- frames before a magnetic switch press is released

-- -- Generated catalogue ------------------------------------------------------
local HLN_AIRCRAFT      = "@@AIRCRAFT@@"
local HLN_CATALOG_HASH  = "@@CATALOG_HASH@@"
local HLN_CATALOG_VER   = "@@CATALOG_VERSION@@"

local HLN_CONTROLS = {
@@CONTROLS@@
}

-- -- State --------------------------------------------------------------------
local hln_tx, hln_rx = nil, nil
local hln_byId = {}
for _, c in ipairs(HLN_CONTROLS) do hln_byId[c.id] = c end
local hln_last = {}            -- id -> last value string sent
local hln_nextSample = 0
local hln_nextFull = 0
local hln_active = false
local hln_releases = {}        -- { device, command, ticks }

-- -- Helpers ------------------------------------------------------------------
local function hln_clamp(v, lo, hi)
    if v < lo then return lo elseif v > hi then return hi end
    return v
end

local function hln_nearest(values, v)
    local best, bestDist = 0, math.huge
    for i, x in ipairs(values) do
        local d = math.abs(x - v)
        if d < bestDist then best, bestDist = i - 1, d end
    end
    return best
end

local function hln_escape(s)
    return (s:gsub("[%%=%c\128-\255]", function(ch) return string.format("%%%02X", ch:byte()) end))
end

local function hln_padLeft(s, n)
    s = s or ""
    if #s > n then return s:sub(1, n) end
    return string.rep(" ", n - #s) .. s
end

-- list_indication() returns blocks separated by dashed lines:
--   -----------------------------------------
--   <field name>
--   <value line(s)>
--   }
local function hln_parseIndication(id)
    local out = {}
    local ok, raw = pcall(list_indication, id)
    if not ok or type(raw) ~= "string" then return out end
    local key, lines = nil, {}
    local function flush()
        if key then out[key] = table.concat(lines, "\n") end
        key, lines = nil, {}
    end
    for line in (raw .. "\n"):gmatch("([^\n]*)\n") do
        if line:match("^%-%-%-%-%-%-") then
            flush()
            key = false            -- next line is the field name
        elseif key == false then
            key = line
        elseif key and line ~= "}" and line ~= "{" and line ~= "children are {" then
            lines[#lines + 1] = line
        end
    end
    flush()
    return out
end

-- -- Reading the cockpit ------------------------------------------------------
local function hln_read(c, dev0, displays)
    if c.style == "indication" then
        local fields = displays[c.display]
        if not fields then
            fields = hln_parseIndication(c.display)
            displays[c.display] = fields
        end
        return "T:" .. hln_escape(hln_padLeft(fields[c.field], c.length))
    end
    if not c.arg or c.style == "step" then return nil end
    local v = dev0:get_argument_value(c.arg)
    if c.style == "tumb" or c.style == "magnetic3" then
        return tostring(hln_nearest(c.values, v))
    elseif c.style == "button" or c.style == "magnetic" then
        return (v > 0.5) and "1" or "0"
    elseif c.style == "lamp" then
        return (v >= (c.threshold or 0.3)) and "1" or "0"
    elseif c.style == "axis" or c.style == "gauge" then
        local lo, hi = c.range[1], c.range[2]
        return tostring(math.floor(hln_clamp((v - lo) / (hi - lo), 0, 1) * 65535 + 0.5))
    end
    return nil
end

local function hln_send(lines, full)
    if not hln_tx then return end
    local header = string.format("HLN 2 %s %s %d %d\n", HLN_CATALOG_HASH, HLN_AIRCRAFT,
                                 hln_active and 1 or 0, full and 1 or 0)
    local buf = header
    for _, l in ipairs(lines) do
        if #buf + #l + 1 > HLN_MAX_DATAGRAM then
            hln_tx:sendto(buf, HLN_HOST, HLN_BRIDGE_PORT)
            buf = header
        end
        buf = buf .. l .. "\n"
    end
    hln_tx:sendto(buf, HLN_HOST, HLN_BRIDGE_PORT)
end

local function hln_sample(now)
    local full = now >= hln_nextFull
    if full then hln_nextFull = now + HLN_FULL_REFRESH end
    if not hln_active then
        if full then hln_send({}, true) end
        return
    end
    local dev0 = GetDevice(0)
    if not dev0 then return end
    local displays, lines = {}, {}
    for _, c in ipairs(HLN_CONTROLS) do
        local ok, value = pcall(hln_read, c, dev0, displays)
        if ok and value and (full or hln_last[c.id] ~= value) then
            hln_last[c.id] = value
            lines[#lines + 1] = string.format("%04X=%s", c.id, value)
        end
    end
    if full or #lines > 0 then hln_send(lines, full) end
end

-- -- Applying inputs ----------------------------------------------------------
local function hln_click(device, command, value)
    local dev = GetDevice(device)
    if dev then dev:performClickableAction(command, value) end
end

local function hln_releaseLater(device, command)
    hln_releases[#hln_releases + 1] = { device = device, command = command, ticks = HLN_RELEASE_TICKS }
end

local function hln_currentPosition(c)
    local dev0 = GetDevice(0)
    if not dev0 or not c.arg then return 0 end
    local v = dev0:get_argument_value(c.arg)
    if c.values then return hln_nearest(c.values, v) end
    return (v > 0.5) and 1 or 0
end

local function hln_apply(c, action, n)
    local s = c.style
    if s == "button" then
        if action == "PRESS" or (action == "SET" and n == 1) then hln_click(c.device, c.command, 1)
        elseif action == "RELEASE" or (action == "SET" and n == 0) then hln_click(c.device, c.command, 0) end
    elseif s == "tumb" then
        local pos = n
        if action == "STEP" then pos = hln_currentPosition(c) + n end
        if action == "SET" or action == "STEP" then
            pos = hln_clamp(pos, 0, #c.values - 1)
            hln_click(c.device, c.command, c.values[pos + 1])
        end
    elseif s == "magnetic" then
        if action == "SET" and hln_currentPosition(c) ~= n then
            hln_click(c.device, c.command, 1)
            hln_releaseLater(c.device, c.command)
        end
    elseif s == "magnetic3" then
        if action ~= "SET" then return end
        local cur = hln_currentPosition(c)
        if n == 2 and cur ~= 2 then
            hln_click(c.device, c.pos_command, 1); hln_releaseLater(c.device, c.pos_command)
        elseif n == 0 and cur ~= 0 then
            hln_click(c.device, c.neg_command, -1); hln_releaseLater(c.device, c.neg_command)
        elseif n == 1 then
            if cur == 2 then hln_click(c.device, c.pos_command, 0)
            elseif cur == 0 then hln_click(c.device, c.neg_command, 0) end
        end
    elseif s == "axis" then
        local lo, hi = c.range[1], c.range[2]
        local v = n
        if action == "STEP" then
            local dev0 = GetDevice(0)
            local raw = dev0 and dev0:get_argument_value(c.arg) or lo
            v = (raw - lo) / (hi - lo) * 65535 + n
        end
        if action == "ANALOG" or action == "STEP" or action == "SET" then
            hln_click(c.device, c.command, lo + hln_clamp(v, 0, 65535) / 65535 * (hi - lo))
        end
    elseif s == "step" and action == "STEP" then
        local value = (n > 0) and c.values[2] or c.values[1]
        for _ = 1, math.min(math.abs(n), 32) do hln_click(c.device, c.command, value) end
    end
end

local function hln_receive()
    if not hln_rx then return end
    for _ = 1, 64 do
        local data = hln_rx:receive()
        if not data then return end
        for line in data:gmatch("[^\n]+") do
            local idHex, action, arg = line:match("^(%x%x%x%x) (%u+) ?([%+%-]?%d*)$")
            local c = idHex and hln_byId[tonumber(idHex, 16)]
            if c and hln_active then
                pcall(hln_apply, c, action, tonumber(arg) or 0)
            end
        end
    end
end

local function hln_tickReleases()
    for i = #hln_releases, 1, -1 do
        local r = hln_releases[i]
        r.ticks = r.ticks - 1
        if r.ticks <= 0 then
            hln_click(r.device, r.command, 0)
            table.remove(hln_releases, i)
        end
    end
end

-- -- DCS export hooks (chained, so DCS-BIOS and others keep working) ------------
local hln_prevStart = LuaExportStart
function LuaExportStart()
    if hln_prevStart then hln_prevStart() end
    package.path = package.path .. ";.\\LuaSocket\\?.lua"
    package.cpath = package.cpath .. ";.\\LuaSocket\\?.dll"
    local okSocket, sock = pcall(require, "socket")
    if not okSocket then
        log.write("HornetLinkNative", log.ERROR, "LuaSocket not available")
        return
    end
    hln_tx = sock.udp()
    hln_tx:settimeout(0)
    hln_rx = sock.udp()
    hln_rx:setsockname(HLN_HOST, HLN_LISTEN_PORT)
    hln_rx:settimeout(0)
    hln_nextSample, hln_nextFull, hln_last = 0, 0, {}
    log.write("HornetLinkNative", log.INFO, "catalogue " .. HLN_CATALOG_VER .. " hash " .. HLN_CATALOG_HASH)
end

local hln_prevStop = LuaExportStop
function LuaExportStop()
    if hln_prevStop then hln_prevStop() end
    if hln_tx then hln_tx:close(); hln_tx = nil end
    if hln_rx then hln_rx:close(); hln_rx = nil end
end

local hln_prevBefore = LuaExportBeforeNextFrame
function LuaExportBeforeNextFrame()
    if hln_prevBefore then hln_prevBefore() end
    local okRx, errRx = pcall(hln_receive)
    if not okRx then log.write("HornetLinkNative", log.ERROR, tostring(errRx)) end
end

local hln_prevAfter = LuaExportAfterNextFrame
function LuaExportAfterNextFrame()
    if hln_prevAfter then hln_prevAfter() end
    pcall(hln_tickReleases)
    local now = LoGetModelTime() or 0
    if now + 5 < hln_nextSample then hln_nextSample, hln_nextFull = 0, 0 end -- mission restarted
    if now < hln_nextSample then return end
    hln_nextSample = now + 1 / HLN_SAMPLE_HZ
    local selfData = LoGetSelfData()
    local wasActive = hln_active
    hln_active = (selfData ~= nil and selfData.Name == HLN_AIRCRAFT)
    if hln_active and not wasActive then
        hln_last = {}
        hln_nextFull = 0
    end
    local okTx, errTx = pcall(hln_sample, now)
    if not okTx then log.write("HornetLinkNative", log.ERROR, tostring(errTx)) end
end
